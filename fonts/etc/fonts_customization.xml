<?xml version="1.0" encoding="utf-8"?>
<fonts-modification version="1">
    <family customizationType="new-named-family" name="lato">
        <font weight="400" style="normal">Lato-Regular.ttf</font>
        <font weight="400" style="italic">Lato-Italic.ttf</font>
        <font weight="500" style="normal">Lato-Medium.ttf</font>
        <font weight="500" style="italic">Lato-MediumItalic.ttf</font>
        <font weight="700" style="normal">Lato-Bold.ttf</font>
        <font weight="700" style="italic">Lato-BoldItalic.ttf</font>
    </family>
    <alias name="lato-medium" to="lato" weight="500"/>
    <alias name="lato-bold" to="lato" weight="700"/>

    <family customizationType="new-named-family" name="rubik">
        <font weight="400" style="normal">Rubik-Regular.ttf</font>
        <font weight="400" style="italic">Rubik-Italic.ttf</font>
        <font weight="500" style="normal">Rubik-Medium.ttf</font>
        <font weight="500" style="italic">Rubik-MediumItalic.ttf</font>
        <font weight="700" style="normal">Rubik-Bold.ttf</font>
        <font weight="700" style="italic">Rubik-BoldItalic.ttf</font>
    </family>
    <alias name="rubik-medium" to="rubik" weight="500"/>
    <alias name="rubik-bold" to="rubik" weight="700"/>

    <family customizationType="new-named-family" name="google-sans-flex">
        <font style="normal" weight="100">GoogleSansFlex-Regular.ttf
            <axis stylevalue="100" tag="wght"/>
        </font>
        <font style="normal" weight="200">GoogleSansFlex-Regular.ttf
            <axis stylevalue="200" tag="wght"/>
        </font>
        <font style="normal" weight="300">GoogleSansFlex-Regular.ttf
            <axis stylevalue="300" tag="wght"/>
        </font>
        <font style="normal" weight="400">GoogleSansFlex-Regular.ttf
            <axis stylevalue="400" tag="wght"/>
        </font>
        <font style="normal" weight="500">GoogleSansFlex-Regular.ttf
            <axis stylevalue="500" tag="wght"/>
        </font>
        <font style="normal" weight="600">GoogleSansFlex-Regular.ttf
            <axis stylevalue="600" tag="wght"/>
        </font>
        <font style="normal" weight="700">GoogleSansFlex-Regular.ttf
            <axis stylevalue="700" tag="wght"/>
        </font>
        <font style="normal" weight="800">GoogleSansFlex-Regular.ttf
            <axis stylevalue="800" tag="wght"/>
        </font>
        <font style="normal" weight="900">GoogleSansFlex-Regular.ttf
            <axis stylevalue="900" tag="wght"/>
        </font>
        <font style="italic" weight="100">GoogleSansFlex-Regular.ttf
            <axis stylevalue="100" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="200">GoogleSansFlex-Regular.ttf
            <axis stylevalue="200" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="300">GoogleSansFlex-Regular.ttf
            <axis stylevalue="300" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="400">GoogleSansFlex-Regular.ttf
            <axis stylevalue="400" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="500">GoogleSansFlex-Regular.ttf
            <axis stylevalue="500" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="600">GoogleSansFlex-Regular.ttf
            <axis stylevalue="600" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="700">GoogleSansFlex-Regular.ttf
            <axis stylevalue="700" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="800">GoogleSansFlex-Regular.ttf
            <axis stylevalue="800" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
        <font style="italic" weight="900">GoogleSansFlex-Regular.ttf
            <axis stylevalue="900" tag="wght"/>
            <axis tag="slnt" stylevalue="-10"/>
        </font>
    </family>
    <alias name="google-sans-flex-medium" to="google-sans-flex" weight="500"/>
    <alias name="google-sans-flex-bold" to="google-sans-flex" weight="700"/>
</fonts-modification>
